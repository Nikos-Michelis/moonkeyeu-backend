local.file_match "log_targets" {
    path_targets = [{
        __address__ = "localhost",
        __path__    = "/var/log/myapp/*.log",
        job         = "nginx_access",
    }]
    sync_period = "15s"
}

loki.source.file "nginx_logs" {
    targets    = local.file_match.log_targets.targets
    forward_to = [loki.process.nginx_processor.receiver]
}

loki.process "nginx_processor" {
    forward_to = [loki.write.default.receiver]

    stage.json {
        expressions = {
            status       = "status",
            timestamp = "time_iso8601",
        }
    }
    stage.timestamp {
        source = "timestamp"
        format = "2006-01-02 15:04:05"
    }

    stage.labels {
        values = {
            status= "status",
        }
    }
}